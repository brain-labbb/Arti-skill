{
  "assembly_notes": "The selected front_family owns the cabinet proportions, hollow tub, layered door, bottom-front X hinge and control placement. It exposes a normalized open-front rack bay, indexed horizontal rack support planes and lower/upper vertical spray axes. Rack width, depth, tier spacing, guide spacing, slide travel, spray span and door dimensions are derived from the selected host. The door is authored open at q=0 and closes at its lower limit, so independent rack endpoint checks remain mechanically meaningful. Every front, rack, accessory, wash-arm and rack-count combination is buildable without a gate.",
  "bindings": [
    {
      "binding_id": "front_to_door",
      "provider": "front_family.door_hinge_axis",
      "consumer": "front_family.door_axis",
      "joint_type": "revolute",
      "derived": [
        {"name": "door_width", "mode": "derived", "expression": "body_width - 0.008 * scale", "depends_on": ["body_width", "scale"], "rationale": "Leaves a narrow reveal inside the front stiles."},
        {"name": "door_height", "mode": "derived", "expression": "body_height - sill_z - 0.010 * scale", "depends_on": ["body_height", "sill_z", "scale"], "rationale": "Closes the full opening without striking the floor."}
      ]
    },
    {
      "binding_id": "front_to_racks",
      "provider": "front_family.rack_support_indexed",
      "consumer": "rack_geometry.bottom_support",
      "joint_type": "prismatic_indexed",
      "derived": [
        {"name": "rack_width", "mode": "derived", "expression": "tub_width - 0.044 * scale", "depends_on": ["tub_width", "scale"], "rationale": "Preserves two runner/side-wall clearances."},
        {"name": "rack_depth", "mode": "derived", "expression": "tub_depth - 0.070 * scale", "depends_on": ["tub_depth", "scale"], "rationale": "Keeps the closed rack behind the gasket and clear of the back wall."},
        {"name": "rack_travel", "mode": "derived", "expression": "min(0.78 * rack_depth, body_depth - 0.090 * scale)", "depends_on": ["rack_depth", "body_depth", "scale"], "rationale": "Allows useful extraction while retaining guide engagement."}
      ]
    },
    {
      "binding_id": "front_to_lower_wash_arm",
      "provider": "front_family.lower_spray_axis",
      "consumer": "wash_arm.rotation_axis",
      "joint_type": "continuous",
      "derived": [
        {"name": "lower_arm_span", "mode": "derived", "expression": "min(0.72 * tub_width, 0.74 * tub_depth)", "depends_on": ["tub_width", "tub_depth"], "rationale": "Keeps the full rotating envelope inside the lower chamber."}
      ]
    },
    {
      "binding_id": "upper_rack_to_wash_arm",
      "provider": "rack_geometry.underside_spray_axis",
      "consumer": "wash_arm.rotation_axis",
      "joint_type": "continuous",
      "derived": [
        {"name": "upper_arm_span", "mode": "derived", "expression": "0.82 * lower_arm_span", "depends_on": ["lower_arm_span"], "rationale": "Fits beneath the upper rack runners and basket walls."}
      ]
    },
    {
      "binding_id": "rack_to_accessory",
      "provider": "rack_geometry.accessory_mount",
      "consumer": "rack_accessory.rack_mount",
      "joint_type": "candidate_specific",
      "derived": [
        {"name": "accessory_span", "mode": "derived", "expression": "0.42 * rack_width", "depends_on": ["rack_width"], "rationale": "Keeps caddy and shelves inside every basket family."}
      ]
    }
  ],
  "multiplicities": [
    {
      "name": "rack_count",
      "item_slot": "rack_geometry",
      "values": [2, 3],
      "spacing_expression": "available_tub_height / (rack_count + 0.45)",
      "host_capacity_expression": "rack_count * rack_clear_height + (rack_count - 1) * tier_clearance <= available_tub_height"
    }
  ],
