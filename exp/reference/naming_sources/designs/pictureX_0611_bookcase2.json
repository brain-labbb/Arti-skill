{
  "assembly_notes": "Four independent structural slots over one grounded carcass part. case_frame owns the case family and exports the aperture interface plus the per-row shelf bays; lower_front consumes only that aperture, so all 6x6x2x3 = 216 combinations build without a gate. Hinged leaves are solved by mate_axes on the real hinge line and registered with register_interface_mate; bypass leaves ride head and sill tracks derived from the aperture width; the pull-out tray and the drawers ride side runners derived from the case depth. Support paths are real geometry: door barrels ride carcass hinge pins on face-frame posts, leaf head rails stay inside their tracks, tray and drawer sides stay 2 mm captured in their runners, and shelf ends 2 mm inside standards that bridge out to the case wall.",
  "bindings": [
    {
      "binding_id": "case_to_front",
      "consumer": "lower_front.front_aperture",
      "derived": [
        {
          "choices": [],
          "depends_on": [
            "width_m"
          ],
          "expression": "hinged: aperture_half_x - door_gap/2; bypass: 1.02*aperture_half_x with travel 1.9*aperture_half_x - leaf_width",
          "mode": "derived",
          "name": "leaf_width_m",
          "rationale": "each leaf covers its half of the aperture",
          "unit": "m",
          "value_type": "float"
        },
        {
          "choices": [],
          "depends_on": [
            "depth_m"
          ],
          "expression": "clamp(0.42*depth_m, 0.08, tray_depth-0.06)",
          "mode": "derived",
          "name": "tray_travel_m",
          "rationale": "the tray stays captured by its runners at full extension",
          "unit": "m",
          "value_type": "float"
        }
      ],
      "joint_type": "prismatic",
      "provider": "case_frame.front_aperture"
    },
    {
      "binding_id": "case_to_shelves",
      "consumer": "shelf_mechanism.shelf_bay",
      "derived": [
