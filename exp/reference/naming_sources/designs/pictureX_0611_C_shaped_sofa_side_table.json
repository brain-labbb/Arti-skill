{
  "assembly_notes": "The root is always the sofa frame. Its underframe is open (four legs and two side rails) so every table frame family can slide its foot beneath the seat. Each sofa_form candidate publishes the seat plan (width, depth, cushion top); the table height derives from that cushion top so the top always clears the seat whatever the sofa. N side tables park outside the sofa ends and slide inward on prismatic joints whose stroke is table_reach_m. table_top and base_form fill the frame's top seat and floor interface. The front platform slides toward the sofa on its own prismatic joint. No ctx.allow_overlap is used anywhere.",
  "bindings": [
    {
      "binding_id": "seat_plan",
      "consumer": "table_frame.seat_plan",
      "derived": [
        {
          "expression": "seat_height_m + 0.115 cushion + 0.075 clearance",
          "mode": "derived",
          "name": "table_height_m",
          "rationale": "The cantilevered top must clear the cushions of every sofa candidate, not a fixed source height.",
          "unit": "m",
          "value_type": "float"
        },
        {
          "expression": "sofa_width_m/2 + table_top_width_m/2 + 0.030",
          "mode": "derived",
          "name": "table_x_m",
          "rationale": "The parked station follows the host width and the chosen top so the table starts beside the sofa.",
          "unit": "m",
          "value_type": "float"
        }
      ],
      "joint_type": "prismatic",
      "provider": "sofa_form.seat_plan"
    },
    {
      "binding_id": "top_seat",
      "consumer": "table_top.top_seat",
      "derived": [
        {
          "expression": "table_height_m + 0.013",
          "mode": "derived",
          "name": "top_z_m",
          "rationale": "Every top plan seats on the same frame rail, so its height follows the frame, not the plan.",
          "unit": "m",
          "value_type": "float"
        }
      ],
      "joint_type": "fixed",
      "provider": "table_frame.top_seat"
    }
  ],
