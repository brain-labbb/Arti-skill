{
  "assembly_notes": "The root is always one vanity_body carcass. Each body_form candidate publishes a drawer zone (a list of slot rectangles cut as real cavities in the carcass) and a worktop plane. The drawer_front candidates fill that zone: N hollow trays on prismatic slides along -Y, with the front hardware being the only difference. The pedestal body adapts the zone from one horizontal row into two vertical stacks, so N stays fully combinable with every body plan. Each mirror_form candidate consumes the worktop plane and adds its own cleat, posts, rail or cabinet to the carcass. Every revolute joint is solved with mate_axes and registered with register_interface_mate; no ctx.allow_overlap is used anywhere.",
  "bindings": [
    {
      "binding_id": "drawer_zone",
      "consumer": "drawer_front.drawer_zone",
      "derived": [
        {
          "expression": "(usable_width - 0.012*(drawer_count-1))/drawer_count - 0.014 for row bodies",
          "mode": "derived",
          "name": "front_width_m",
          "rationale": "Front width must follow the host zone and N, not a fixed source constant.",
          "unit": "m",
          "value_type": "float"
        },
        {
          "expression": "0.62 * body_depth_m",
          "mode": "derived",
          "name": "drawer_travel_m",
          "rationale": "Travel derives from the host box depth so a fully open drawer still keeps its runners engaged.",
          "unit": "m",
          "value_type": "float"
        }
      ],
      "joint_type": "prismatic",
      "provider": "body_form.drawer_zone"
    },
    {
      "binding_id": "worktop",
      "consumer": "mirror_form.worktop",
      "derived": [
        {
          "expression": "leg_height_m + carcass_height_m + 0.024",
          "mode": "derived",
          "name": "top_z_m",
          "rationale": "Every mirror candidate mounts its cleat, posts, rail or cabinet on this height.",
          "unit": "m",
          "value_type": "float"
        },
        {
          "expression": "min(mirror_width_m, body_width_m - clearance) per candidate",
          "mode": "derived",
          "name": "mirror_span_m",
          "rationale": "A large mirror on a narrow worktop must be clipped to the host plan, not left overhanging.",
          "unit": "m",
          "value_type": "float"
        }
      ],
      "joint_type": "fixed",
      "provider": "body_form.worktop"
    }
  ],
