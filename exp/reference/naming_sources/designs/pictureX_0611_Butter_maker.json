{
  "assembly_notes": "The root is always the vessel. Each vessel_form candidate publishes its rim plane (bore and rim height); the lid plus the drive frame is fixed on that rim, and the mount_form candidate adds either a countertop foot ring or a floor cradle to the same vessel. Mounts contain no separate parts or joints: every seed is articulated by the category-defining dasher drive. The dasher shaft runs in a bored lid bearing: rotary drives make it continuous, the plunger family makes it prismatic. Each drive_form candidate adds exactly one drive head (side crank on a bevel pair, a free-spinning handle on a direct crank arm, a plunger top grip, or a motor housing). N dasher blades are fixed on the shaft at an even angular pitch, with the blade radius derived from the bore so every N keeps wall clearance. All continuous joints are solved with mate_axes and registered with register_interface_mate; the bevel pair meshes with a 1 mm running gap. No ctx.allow_overlap is used anywhere.",
  "bindings": [
    {
      "binding_id": "vessel_rim",
      "consumer": "mount_form.vessel_rim",
      "derived": [
        {
          "expression": "vessel_bore_m/2 + 0.005 wall, times 1.04 skirt; the box vessel switches the lid to a square plan",
          "mode": "derived",
          "name": "lid_radius_m",
          "rationale": "The lid and frame footprint must follow the vessel plan, not stay circular over a square body.",
          "unit": "m",
          "value_type": "float"
        },
        {
          "expression": "0.070 for floor_stand, 0 otherwise",
          "mode": "derived",
          "name": "stand_lift_m",
          "rationale": "The floor cradle raises the whole vessel, so every downstream height derives from the same lift.",
          "unit": "m",
          "value_type": "float"
        }
      ],
      "joint_type": "fixed",
      "provider": "vessel_form.vessel_rim"
    },
    {
      "binding_id": "blade_hub",
      "consumer": "dasher_form.blade_hub",
      "derived": [
        {
          "expression": "vessel_bore_m/2 - 0.006",
          "mode": "derived",
          "name": "blade_radius_m",
          "rationale": "Blades must sweep the bore with a real wall clearance at every vessel and every N.",
          "unit": "m",
          "value_type": "float"
        },
        {
          "expression": "0.34 * vessel_height_m, referred back through the lid and shaft origins",
          "mode": "derived",
          "name": "blade_station_m",
          "rationale": "The plunger stroke must keep the blades below the lid and above the vessel floor.",
          "unit": "m",
          "value_type": "float"
