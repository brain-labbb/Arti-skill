{
 "assembly_notes": "One clearance ledger owns the mechanism: bore_half is the half-size of the guide opening, rod_half the half-size of what runs in it, and engage_min the rod length that must remain captured at full extension. stroke is SOLVED as guide_len - engage_min, which is the law the deleted template violated - it let every stage pull clean out of its guide. stage_count repeats the same stage module; each stage carries the guide for the next, and its stroke is re-derived from that guide's own length. The output member always adds exactly one revolute, carried either by the host or by the last plunger.",
 "bindings": [
  {
   "binding_id": "stroke_from_guide_engagement",
   "consumer": "plunger_rod.shank",
   "derived": [
    {
     "choices": [],
     "depends_on": [
      "guide_len",
      "engage_min"
     ],
     "expression": "clamp(guide_len - engage_min, 0.006, guide_len * 0.62)",
     "maximum": null,
     "minimum": null,
     "mode": "derived",
     "name": "stroke",
     "rationale": "the rod must still be held by engage_min of bore at full extension; this is the law the deleted template broke",
     "unit": "m",
     "value_type": "float"
    }
   ],
   "provider": "guide_section.bore"
  },
  {
   "binding_id": "rod_section_from_bore",
   "consumer": "plunger_rod.shank",
   "derived": [
    {
     "choices": [],
     "depends_on": [
      "bore_half"
     ],
     "expression": "bore_half - running_clearance",
     "maximum": null,
     "minimum": null,
     "mode": "derived",
     "name": "rod_half",
     "rationale": "a square bar in a round bore or a round rod in a rect bore both size off the same opening",
     "unit": "m",
     "value_type": "float"
    }
   ],
   "provider": "guide_section.bore"
  },
  {
   "binding_id": "hinge_from_output_reach",
   "consumer": "hinge_carrier.clevis",
   "derived": [
    {
     "choices": [],
     "depends_on": [
      "stroke",
      "output_reach"
     ],
     "expression": "host front + tip stand-off so the plunger tip meets the member's input face within the stroke",
     "maximum": null,
     "minimum": null,
     "mode": "derived",
     "name": "pivot_offset",
     "rationale": "the stroke has to actually reach the member it drives",
     "unit": "m",
     "value_type": "float"
    }
   ],
   "provider": "output_member.pivot"
  }
 ],
