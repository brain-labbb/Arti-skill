            "top_thickness_m"
          ],
          "expression": "under_top_z_m - hinge_r, on the station's x line",
          "mode": "derived",
          "name": "hinge_axis_z_m",
          "rationale": "the fold axis rides the under-top rail",
          "unit": "m",
          "value_type": "float"
        },
        {
          "choices": [],
          "depends_on": [
            "top_length_m",
            "leg_count"
          ],
          "expression": "stations left of centre fold with positive q, right of centre with negative q",
