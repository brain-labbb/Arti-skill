{
 "assembly_notes": "axis_family owns the joint topology: it decides whether the straddle gap opens along Y (pitch_clevis), along Z (yaw_clevis), or is replaced by a bearing-disc stack (yaw_stacked). Every other slot adapts to it. mount derives mount_top_z and a ground-envelope half-width; the shoulder lower limit is solved from that envelope so the upper link can never sweep into its own base. bearing_detail only adds coaxial hardware and never changes the axis. Link bodies expose root/tip hub depth and section height so the opposite bearing derives its straddle gap. end_effector exposes a mount footprint that the forearm tip derives its wrist block from.",
 "bindings": [
  {
   "binding_id": "shoulder_axis_from_mount",
   "consumer": "axis_family.shoulder_axis",
   "derived": [
    {
     "choices": [],
     "depends_on": [
      "mount_height_m"
     ],
     "expression": "per-mount stack height; ceiling_underslung returns a negative-going seat so the chain hangs below",
     "maximum": null,
     "minimum": null,
     "mode": "derived",
     "name": "mount_top_z",
     "rationale": "the shoulder joint origin must come from the mount it is actually bolted to",
     "unit": "m",
     "value_type": "float"
    },
    {
     "choices": [],
     "depends_on": [
      "mount_top_z",
      "mount_envelope_half_x",
      "upper_len"
     ],
     "expression": "-acos(clamp((mount_envelope_half_x + clearance) / upper_len, -1, 1)) bounded to [-2.2, -0.15]",
     "maximum": null,
     "minimum": null,
     "mode": "derived",
     "name": "shoulder_lower_rad",
     "rationale": "solves the swing angle at which the upper link would first reach the mount envelope, replacing the hardcoded limit tuples that made the deleted template fail every seed",
     "unit": "rad",
     "value_type": "float"
    }
   ],
   "provider": "mount.shoulder_axis"
  },
  {
   "binding_id": "elbow_straddle_from_upper_tip",
   "consumer": "forearm_body.root_hub",
   "derived": [
    {
     "choices": [],
     "depends_on": [
      "forearm_hub_len"
     ],
     "expression": "forearm_hub_len + 2*bearing_clearance",
     "maximum": null,
     "minimum": null,
     "mode": "derived",
     "name": "elbow_gap",
     "rationale": "the cheek offset is derived from the mating hub so the straddle always has a real gap",
     "unit": "m",
     "value_type": "float"
    }
   ],
   "provider": "upper_link_body.tip_hub"
  },
  {
   "binding_id": "wrist_from_end_effector_footprint",
   "consumer": "forearm_body.tip_face",
   "derived": [
    {
     "choices": [],
     "depends_on": [
      "ee_footprint_y",
      "ee_footprint_z"
     ],
     "expression": "max(section_y, ee_footprint_y*0.62) x max(section_z, ee_footprint_z*0.62)",
     "maximum": null,
     "minimum": null,
     "mode": "derived",
     "name": "wrist_block_size",
     "rationale": "the forearm tip grows a wrist block that actually carries the selected output face",
     "unit": "m",
     "value_type": "float"
    }
   ],
   "provider": "end_effector.mount_footprint"
  }
 ],
 "category_anchors": [
