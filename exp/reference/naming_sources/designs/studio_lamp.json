{
  "assembly_notes": "Full Cartesian assembly. Ground support provides a centered mast socket; N nested mast stages provide a top receiver; the selected mechanism adapts its fork span and cheek height to the selected head envelope. Source-family materials are semantic roles, not a global palette. All rotational axes use solved and registered AxisInterface mates.",
  "bindings": [
    {
      "binding_id": "support_to_mast",
      "provider": "ground_support.mast_socket",
      "consumer": "mast_profile.base_socket",
      "joint_type": "prismatic_nested",
      "derived": [
        {"name": "stage_outer_radius", "mode": "derived", "expression": "base_outer_radius - stage_index * radius_step", "depends_on": ["base_outer_radius", "stage_index", "radius_step"], "rationale": "Every mast stage is a genuinely smaller captured tube."},
        {"name": "stage_travel", "mode": "derived", "expression": "min(0.14 * mast_travel_scale, 0.9 * (stage_length - insertion_overlap))", "depends_on": ["mast_travel_scale", "stage_length", "insertion_overlap"], "rationale": "Maintains deep insertion at both limits."}
      ]
    },
    {
      "binding_id": "mast_to_mechanism",
      "provider": "mast_profile.top_receiver",
      "consumer": "head_support_mechanism.mast_receiver",
      "joint_type": "candidate_specific",
      "derived": [{"name": "mechanism_height", "mode": "derived", "expression": "head_half_height + sweep_clearance", "depends_on": ["head_half_height", "sweep_clearance"], "rationale": "Allows the selected head to tilt without a universal fixed frame."}]
    },
    {
      "binding_id": "mechanism_to_head",
      "provider": "head_support_mechanism.head_tilt_axis",
      "consumer": "lamp_head_assembly.trunnion_axis",
      "joint_type": "revolute",
      "derived": [
        {"name": "fork_inside_half_span", "mode": "derived", "expression": "head_half_width + side_clearance", "depends_on": ["head_half_width", "side_clearance"], "rationale": "Adapts fork width to every source head envelope."},
        {"name": "trunnion_length", "mode": "derived", "expression": "2 * (fork_inside_half_span + bearing_thickness)", "depends_on": ["fork_inside_half_span", "bearing_thickness"], "rationale": "Captures both bearings without arbitrary universal width."}
      ]
    }
  ],
  "multiplicities": [
    {"name": "radial_support_count", "item_slot": "ground_support", "values": [3, 4, 5, 6, 7], "spacing_expression": "2 * pi / radial_support_count", "host_capacity_expression": "hub_circumference >= radial_support_count * attachment_width"},
    {"name": "mast_stage_count", "item_slot": "mast_profile", "values": [1, 2, 3], "spacing_expression": "stage_length - insertion_overlap", "host_capacity_expression": "base_outer_radius - mast_stage_count * radius_step >= minimum_top_radius"}
  ],
