{
  "assembly_notes": "Three independent structural slots plus the support multiplicity. top_style owns the tabletop family and exports the under-top interface (top plane, usable half-length/half-depth and one hinge line per station); support_style consumes only that interface and reports its foot positions, which foot_style consumes. All 4x7x3 = 84 combinations build without a gate. Every fold axis is solved by mate_axes and registered with register_interface_mate; supports ride carcass-side hinge pins carried on bracket cheeks, so a folded support keeps a real support path at every angle. For the split tops the stations right of the seam hang from the moving half, so the whole table still folds as one assembly.",
  "bindings": [
    {
      "binding_id": "top_to_support",
      "consumer": "support_style.under_top",
      "derived": [
        {
          "choices": [],
          "depends_on": [
            "top_height_m",
            "top_thickness_m"
          ],
          "expression": "under_top_z_m - hinge_r, on the station's x line",
          "mode": "derived",
          "name": "hinge_axis_z_m",
          "rationale": "the fold axis rides the under-top rail",
          "unit": "m",
          "value_type": "float"
        },
        {
          "choices": [],
          "depends_on": [
            "top_length_m",
            "leg_count"
          ],
          "expression": "stations left of centre fold with positive q, right of centre with negative q",
          "mode": "derived",
          "name": "fold_direction",
          "rationale": "every support folds inward under the top",
          "unit": "ratio",
          "value_type": "ratio"
        }
      ],
      "joint_type": "revolute",
      "provider": "top_style.under_top"
    },
    {
      "binding_id": "support_to_foot",
      "consumer": "foot_style.foot_plane",
      "derived": [
        {
          "choices": [],
          "depends_on": [
            "top_depth_m"
          ],
          "expression": "the support reports its foot y positions; the foot candidate sizes pads or the rail from them",
          "mode": "derived",
          "name": "foot_span_m",
          "rationale": "pads and rails must match the support's real footprint",
          "unit": "m",
          "value_type": "float"
        }
      ],
      "joint_type": "fixed",
      "provider": "support_style.under_top"
    }
  ],
