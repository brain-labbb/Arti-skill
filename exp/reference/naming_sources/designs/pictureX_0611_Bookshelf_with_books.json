{
  "assembly_notes": "Four independent structural slots over a grounded moulded base and one sorter body. tray_body owns the deck family and exports the deck interface (deck plane, usable half-width, bay depth, wall height); end_walls, divider_mechanism and base_style consume only that interface, so all 5x3x3x2 = 90 combinations build without a gate. The source's signature perforation is real through-geometry (SlotPatternPanelGeometry, a 5x5 rounded slot grid derived from the panel size), not a solid placeholder. Fold-flat end walls are solved by mate_axes and registered with register_interface_mate; dividers are placed by mate_planes against the declared bay extent and ride a guide rod (sliding) or stay captured between socket cheeks (lift-out). Filed contents are sparse decoration sized to clear the divider travel envelope, because the authoritative image shows the sorter empty.",
  "bindings": [
    {
      "binding_id": "deck_to_dividers",
      "consumer": "divider_mechanism.deck_plane",
      "derived": [
        {
          "choices": [],
          "depends_on": [
            "width_m",
            "divider_count"
          ],
          "expression": "min(clamp(0.26*bay_pitch_m, 0.004, 0.045), clear_gap/2) with clear_gap = bay_pitch_m - 2*half_span - 0.004 and half_span = max(0.9*panel_thickness_m, 0.18*bay_pitch_m for sliding bookends)",
          "mode": "derived",
          "name": "divider_travel_m",
          "rationale": "two neighbouring dividers may never meet at opposite travel extremes",
          "unit": "m",
          "value_type": "float"
        },
        {
          "choices": [],
          "depends_on": [
            "width_m",
            "divider_count"
          ],
          "expression": "divider_travel_m + 0.030 for lift-out sockets",
          "mode": "derived",
          "name": "socket_height_m",
          "rationale": "the lifted divider stays captured in its socket",
          "unit": "m",
          "value_type": "float"
        }
      ],
      "joint_type": "prismatic",
      "provider": "tray_body.deck_plane"
    },
    {
      "binding_id": "deck_to_end_walls",
      "consumer": "end_walls.deck_plane",
      "derived": [
        {
          "choices": [],
          "depends_on": [
            "width_m",
            "panel_thickness_m"
          ],
          "expression": "+/-(width_m/2 - panel_thickness_m) at z = 0.010",
          "mode": "derived",
          "name": "fold_axis_x_m",
          "rationale": "the fold axis rides the deck edge",
          "unit": "m",
          "value_type": "float"
        }
      ],
      "joint_type": "revolute",
      "provider": "tray_body.deck_plane"
    },
    {
      "binding_id": "base_to_tray",
