      "derived": [
        {
          "choices": [],
          "depends_on": [
            "base_style"
          ],
          "expression": "base_lift_m + deck thickness - 0.002 so the deck seats 2 mm onto its rails or feet",
          "mode": "derived",
          "name": "deck_z_m",
          "rationale": "the sorter body is never a floating island",
          "unit": "m",
          "value_type": "float"
        }
      ],
      "joint_type": "fixed",
      "provider": "base_style.deck_mount"
    }
