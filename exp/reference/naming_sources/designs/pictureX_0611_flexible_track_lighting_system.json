{
  "assembly_notes": "One lighting_track (root) carries N independently aimable heads. Each head is a pan_gimbal (REVOLUTE about vertical Z) plus a light_head (REVOLUTE about horizontal Y tilt trunnion, parent=gimbal). The track_adapter slot decides how the pan REVOLUTE reaches the track: flush_block (REC_001) embeds the mount as fixed track geometry so the pan joint's parent IS the track link, while shoe_spindle_mount (REC_002) emits one rail-shoe LINK per head, bolts it to the track with a FIXED joint, and re-parents the pan REVOLUTE onto that link's spindle. head_count is the multiplicity applied to light_head; it emits one gimbal, one pan joint, one tilt joint and (with shoe_spindle_mount) one adapter link plus one FIXED mount joint per head. Head pan-pivot spacing is derived from the worst-case pan/tilt motion envelope (head_length_m, head_radius_m, tilt_max) so adjacent heads never collide; the straight rail length and the oval semi-axes are both derived from head_count and that spacing. track x adapter x head x gimbal fully combine: the head always exposes a Y-axis pivot axle any yoke can capture, both gimbals expose the same swivel-seat top plane at their pan origin, and the shoe seats on the rail underside plane that both track candidates provide.",
  "bindings": [
    {
      "binding_id": "track_to_adapter_seat",
      "consumer": "track_adapter.rail_seat",
      "derived": [
        {
          "depends_on": [],
          "expression": "rail_underside_z - shoe_half_height + 0.0005",
          "mode": "derived",
          "name": "shoe_seat_z",
          "rationale": "The rail shoe's top face is pressed 0.5 mm into the rail underside so the seat is genuine contact while the world-AABB overlap stays under the 1 mm collision tolerance on Z."
        }
      ],
      "joint_type": "fixed",
      "provider": "lighting_track.adapter_seat"
    },
    {
      "binding_id": "track_to_gimbal_pan",
      "consumer": "pan_gimbal.pan_mount",
      "derived": [
        {
          "depends_on": [
            "head_length_m",
            "tilt_max",
            "head_radius_m",
            "yoke_half_width",
            "clearance"
          ],
          "expression": "2*(head_length_m*sin(tilt_max)+head_radius_m+yoke_half_width)+clearance",
          "mode": "derived",
          "name": "head_spacing",
          "rationale": "Track span/pivot spacing derives from the swept head envelope so adjacent heads stay clear at full tilt."
        }
      ],
      "joint_type": "revolute",
      "provider": "lighting_track.pan_axis"
    },
    {
      "binding_id": "gimbal_to_head_tilt",
      "consumer": "light_head.tilt_mount",
      "derived": [
        {
          "depends_on": [
            "drop_length_m"
          ],
          "expression": "-drop_length_m",
          "mode": "derived",
          "name": "tilt_pivot_drop",
          "rationale": "The tilt trunnion sits drop_length_m below the pan pivot in the gimbal frame."
        }
      ],
      "joint_type": "revolute",
      "provider": "pan_gimbal.tilt_axis"
    }
  ],
