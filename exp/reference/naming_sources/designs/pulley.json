{
  "assembly_notes": "The frame owns the wheel chamber, bearing cheeks, captured axle, retainers and optional gate. N is assembly-owned: it derives sheave pitch, stack width, cheek centers, shell cavity width, axle length, thrust-washer positions and gate offset. The mount interface attaches at the rear bridge and the optional becket attaches at the opposite bridge. Every frame, mount, sheave profile, secondary module and N combination is buildable without a gate. All rotating joints use solved and registered axis interfaces.",
  "bindings": [
    {
      "binding_id": "frame_to_sheaves",
      "consumer": "sheave_profile.rotation_axis",
      "derived": [
        {
          "depends_on": ["sheave_width"],
          "expression": "sheave_width + 0.0012",
          "mode": "derived",
          "name": "sheave_pitch",
          "rationale": "Provides visible thrust clearance between independently rotating wheels."
        },
        {
          "depends_on": ["sheave_count", "sheave_width", "sheave_pitch"],
          "expression": "sheave_width + (sheave_count - 1) * sheave_pitch",
          "mode": "derived",
          "name": "stack_width",
          "rationale": "Exact indexed wheel-stack capacity."
        },
        {
          "depends_on": ["stack_width", "cheek_thickness"],
          "expression": "0.5 * stack_width + cheek_thickness + 0.0010",
          "mode": "derived",
          "name": "cheek_center_x",
          "rationale": "Places both bearing cheeks outside the rotating stack."
        },
        {
          "depends_on": ["cheek_center_x", "cheek_thickness"],
          "expression": "2 * (cheek_center_x + cheek_thickness)",
          "mode": "derived",
          "name": "axle_length",
          "rationale": "Keeps the transverse pin captured through both cheeks."
        }
      ],
      "joint_type": "continuous_indexed",
      "provider": "frame_construction.sheave_axis"
    },
    {
      "binding_id": "frame_to_mount",
      "consumer": "mount_interface.frame_mount",
      "derived": [
        {
          "depends_on": ["stack_width", "cheek_thickness"],
          "expression": "max(0.034 * pulley_scale, stack_width + 2 * cheek_thickness + 0.004)",
          "mode": "derived",
          "name": "bridge_width",
          "rationale": "Adapts every mount bridge to the selected wheel stack."
        }
      ],
      "joint_type": "candidate_specific",
      "provider": "frame_construction.mount_bridge"
    },
    {
      "binding_id": "frame_to_secondary",
      "consumer": "secondary_module.frame_mount",
