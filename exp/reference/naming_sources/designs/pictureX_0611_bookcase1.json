{
  "assembly_notes": "Four independent structural slots over one grounded carcass part. case_frame owns the case family and exports the aperture interface plus the per-row shelf bays; lower_front consumes only that aperture, so all 7x5x2x3 = 210 combinations build without a gate. Every revolute leaf is solved by mate_axes on the real hinge line and registered with register_interface_mate; adjustable shelves are placed by mate_planes against the declared shelf-bay extent. Support paths are real geometry: door barrels ride carcass hinge pins carried on face-frame posts, drawer sides stay 2 mm captured inside their runners, and shelf ends 2 mm inside standards that bridge out to the case wall.",
  "bindings": [
    {
      "binding_id": "case_to_front",
      "consumer": "lower_front.front_aperture",
      "derived": [
        {
          "choices": [],
          "depends_on": [
            "width_m"
          ],
          "expression": "aperture_half_x - door_gap/2",
          "mode": "derived",
          "name": "leaf_width_m",
          "rationale": "each leaf covers half the aperture with a centre seam",
          "unit": "m",
          "value_type": "float"
        },
        {
          "choices": [],
          "depends_on": [
            "depth_m"
          ],
          "expression": "clamp(0.46*depth_m, 0.09, box_depth-0.06)",
          "mode": "derived",
          "name": "drawer_travel_m",
          "rationale": "the tray stays captured by its runners at full extension",
          "unit": "m",
          "value_type": "float"
        }
      ],
      "joint_type": "revolute",
      "provider": "case_frame.front_aperture"
    },
    {
      "binding_id": "case_to_shelves",
      "consumer": "shelf_mechanism.shelf_bay",
      "derived": [
        {
          "choices": [],
          "depends_on": [
            "shelf_thickness_m",
            "height_m"
          ],
          "expression": "min(0.050, max(0.012, 0.35*(shelf_pitch_m - shelf_thickness_m)))",
          "mode": "derived",
          "name": "shelf_travel_m",
          "rationale": "the shelf may never reach its neighbour bay",
          "unit": "m",
          "value_type": "float"
        },
        {
          "choices": [],
          "depends_on": [
            "shelf_thickness_m"
          ],
          "expression": "0.002 constant engagement inside a standard that bridges out to the case wall",
          "mode": "derived",
          "name": "pilaster_engage_m",
          "rationale": "the moving shelf keeps a real support path at every pose",
          "unit": "m",
          "value_type": "float"
        }
      ],
      "joint_type": "prismatic",
      "provider": "case_frame.shelf_bay"
    }
  ],
