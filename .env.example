# Repository layout
ARTI_TEMPLATE_DIR=./arti-template
ARTICRAFT_DATA_REPO=./articraft_data
ARTICRAFT_RECORDS_DIR=./articraft_data/data/records
ARTI_RUNTIME_REPO=template

# Evaluation pilot
ARTI_EVAL_MANIFEST=./eval_pilot/manifest.jsonl
ARTI_EVAL_ARTIFACTS=./eval_pilot/artifacts
BLENDER_BIN=

# Bootstrap switches. Large LFS payloads are opt-in.
ARTI_PULL_LFS=0
ARTI_LFS_INCLUDE=data/records/**,picture/**
ARTI_SETUP_TEMPLATE=0
ARTI_SETUP_DATA=0

# Compatible vision API; keep real credentials in .env only.
OPENAI_BASE_URL=
OPENAI_API_KEY=
